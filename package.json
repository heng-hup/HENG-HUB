{
  "name": "heng-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "🌏 HENG-HUB Frontend – Marketplace, Wallet, Chat, Live, and Global Payment by HENG HENG GLOBAL CO., LTD.",
  "author": "HENG HENG GLOBAL CO., LTD.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npx wrangler pages deploy dist --project-name=heng-hub --branch=production",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "axios": "^1.7.3",
    "dotenv": "^16.4.5",
    "firebase": "^12.10.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^6.30.3",
    "react-window": "^2.2.7",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.34.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "cloudflare": {
    "pages": {
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rootDirectory": "heng-frontend",
      "environment": {
        "NODE_ENV": "production",
        "BUILD_ENV": "cloudflare",
        "AUTO_DEPLOY": "true"
      }
    }
  }
}
